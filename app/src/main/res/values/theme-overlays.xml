<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Accent overlays: applied on top of the DayNight themes via
         ThemeUtils.applyAccent(). Each overlay redefines the primary
         key colors; M3 derives the rest. Night color values come from
         values-night/colors.xml automatically. -->
    <style name="AccentOverlay.Purple" parent="">
        <item name="colorPrimary">@color/accent_purple</item>
        <item name="colorOnPrimary">@color/on_accent_purple</item>
        <item name="colorPrimaryContainer">@color/container_purple</item>
        <item name="colorOnPrimaryContainer">@color/on_container_purple</item>
        <item name="colorSecondary">@color/accent_purple</item>
        <item name="colorPrimaryVariant">@color/colorAccentDark</item>
    </style>

    <style name="AccentOverlay.Blue" parent="">
        <item name="colorPrimary">@color/accent_blue</item>
        <item name="colorOnPrimary">@color/on_accent_blue</item>
        <item name="colorPrimaryContainer">@color/container_blue</item>
        <item name="colorOnPrimaryContainer">@color/on_container_blue</item>
        <item name="colorSecondary">@color/accent_blue</item>
        <item name="colorPrimaryVariant">@color/accent_blue_dark</item>
    </style>

    <style name="AccentOverlay.Orange" parent="">
        <item name="colorPrimary">@color/accent_orange</item>
        <item name="colorOnPrimary">@color/on_accent_orange</item>
        <item name="colorPrimaryContainer">@color/container_orange</item>
        <item name="colorOnPrimaryContainer">@color/on_container_orange</item>
        <item name="colorSecondary">@color/accent_orange</item>
        <item name="colorPrimaryVariant">@color/accent_orange_dark</item>
    </style>

    <style name="AccentOverlay.Slate" parent="">
        <item name="colorPrimary">@color/accent_slate</item>
        <item name="colorOnPrimary">@color/on_accent_slate</item>
        <item name="colorPrimaryContainer">@color/container_slate</item>
        <item name="colorOnPrimaryContainer">@color/on_container_slate</item>
        <item name="colorSecondary">@color/accent_slate</item>
        <item name="colorPrimaryVariant">@color/accent_slate_dark</item>
    </style>


    <style name="AccentOverlay.Link" parent="">
        <item name="colorPrimary">@color/accent_link</item>
        <item name="colorOnPrimary">@color/on_accent_link</item>
        <item name="colorPrimaryContainer">@color/container_link</item>
        <item name="colorOnPrimaryContainer">@color/on_container_link</item>
        <item name="colorSecondary">@color/accent_link</item>
        <item name="colorPrimaryVariant">@color/accent_link_dark</item>
    </style>
</resources>
