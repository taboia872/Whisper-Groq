<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Groq API -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="10dp"
                android:textSize="20sp"
                android:text="@string/settings_groq" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:text="@string/settings_api_key_hint" />

            <EditText
                android:id="@+id/editApiKey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:hint="gsk_..."
                android:inputType="textPassword" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textSize="16sp"
                android:textColor="@color/colorAccent"
                android:text="@string/settings_model" />

            <Spinner
                android:id="@+id/spinnerModel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp" />

            <!-- General -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="10dp"
                android:textSize="20sp"
                android:text="@string/settings_general" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:textSize="16sp"
                android:textColor="@color/colorAccent"
                android:text="@string/settings_minimum_silence" />

            <com.google.android.material.slider.RangeSlider
                android:id="@+id/settings_min_silence"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:valueFrom="0"
                android:valueTo="3000"
                android:stepSize="100" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textSize="16sp"
                android:textColor="@color/colorAccent"
                android:text="@string/settings_max_recording" />

            <EditText
                android:id="@+id/editMaxSeconds"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:inputType="number"
                android:hint="60" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:text="@string/settings_max_recording_hint" />

            <!-- Visibility toggles for buttons -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="10dp"
                android:textSize="20sp"
                android:text="@string/settings_buttons" />

            <CheckBox
                android:id="@+id/togglePunctuation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/toggle_punctuation"
                android:textSize="14sp" />

            <CheckBox
                android:id="@+id/toggleKeyboard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/toggle_keyboard_button"
                android:textSize="14sp" />

            <CheckBox
                android:id="@+id/toggleAuto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/toggle_auto_mode"
                android:textSize="14sp" />

        </LinearLayout>
    </ScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
