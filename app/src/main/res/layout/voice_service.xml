<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:clipToPadding="false"
    android:padding="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/keyboard_bg"
        android:padding="8dp">

        <ProgressBar
            android:id="@+id/processing_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:indeterminate="false"
            android:progressTint="@color/ime_accent"
            android:progressBackgroundTint="@color/ime_surface_container_high"
            android:indeterminateTint="@color/ime_accent"
            style="?android:attr/progressBarStyleHorizontal"/>

        <TextView
            android:id="@+id/tv_status"
            android:visibility="gone"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="10dp"
            android:layout_marginTop="4dp"
            android:textSize="14sp"
            android:textColor="@color/ime_text_primary" />

        <!-- Mic center (56dp, 2/3 of original 80dp) -->
        <ImageButton
            android:id="@+id/btnRecord"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginVertical="6dp"
            android:background="@drawable/kb_mic_button"
            android:padding="14dp"
            android:src="@drawable/ic_mic_48dp"
            android:contentDescription="@string/record_button"/>

        <!-- Unified row: kb | . | , | ! | ? | space | del | enter -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <ImageButton
                android:id="@+id/btnKeyboard"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:background="@drawable/kb_button"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_keyboard_36dp"
                android:contentDescription="@string/exit_button"/>

            <TextView
                android:id="@+id/btnPeriod"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:background="@drawable/kb_button"
                android:gravity="center"
                android:text="."
                android:textColor="@color/ime_text_primary"
                android:textSize="20sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/btnComma"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:background="@drawable/kb_button"
                android:gravity="center"
                android:text=","
                android:textColor="@color/ime_text_primary"
                android:textSize="20sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/btnExclaim"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:background="@drawable/kb_button"
                android:gravity="center"
                android:text="!"
                android:textColor="@color/ime_text_primary"
                android:textSize="20sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/btnQuestion"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:background="@drawable/kb_button"
                android:gravity="center"
                android:text="?"
                android:textColor="@color/ime_text_primary"
                android:textSize="20sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/btnSpace"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="2"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:background="@drawable/kb_button"
                android:gravity="center"
                android:text="␣"
                android:textColor="@color/ime_text_primary"
                android:textSize="16sp"/>

            <ImageButton
                android:id="@+id/btnDel"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:background="@drawable/kb_button"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_keyboard_del_48dp"
                android:contentDescription="@string/delete_button"/>

            <ImageButton
                android:id="@+id/btnEnter"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:background="@drawable/kb_button"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_keyboard_return_48dp"
                android:contentDescription="@string/return_button"/>
        </LinearLayout>

    </LinearLayout>
</LinearLayout>
