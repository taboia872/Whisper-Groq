<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="bottom"
    android:clipToPadding="false"
    android:padding="6dp">

    <LinearLayout
        android:id="@+id/ime_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/keyboard_bg"
        android:padding="8dp">

        <!-- Top row: LED -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical|end"
            android:layout_marginBottom="6dp">

            <ImageView
                android:id="@+id/btnStatus"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_gravity="center_vertical|end"
                android:layout_marginEnd="2dp"
                android:adjustViewBounds="true"
                android:src="@drawable/status_led_idle"
                android:contentDescription="Status"
                android:scaleType="fitCenter"/>

            <TextView
                android:id="@+id/tv_status"
                android:visibility="gone"
                android:gravity="center"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:paddingHorizontal="10dp"
                android:textSize="14sp"
                android:textColor="?attr/colorOnSurface" />
        </LinearLayout>

        <!-- Mic center -->
        <ImageButton
            android:id="@+id/btnRecord"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginVertical="6dp"
            android:background="@drawable/kb_mic_button"
            android:padding="14dp"
            android:src="@drawable/ic_mic_48dp"
            android:contentDescription="@string/record_button"/>

        <!-- Buttons row 1: keyboard | select-all | cut | copy | paste -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <ImageButton
                android:id="@+id/btnKeyboard"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:background="@drawable/kb_button"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_keyboard_36dp"
                android:contentDescription="@string/exit_button"/>

            <ImageButton
                android:id="@+id/btnSelectAll"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:background="@drawable/kb_button"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_select_all_24dp"
                android:contentDescription="Select all"/>

            <ImageButton
                android:id="@+id/btnCut"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:background="@drawable/kb_button"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_cut_24dp"
                android:contentDescription="Cut"/>

            <ImageButton
                android:id="@+id/btnCopy"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:background="@drawable/kb_button"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_copy_24dp"
                android:contentDescription="Copy"/>

            <ImageButton
                android:id="@+id/btnPaste"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:background="@drawable/kb_button"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_paste_24dp"
                android:contentDescription="Paste"/>
        </LinearLayout>

        <!-- Buttons row 2: punctuation | numbers | del | enter -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <ImageButton
                android:id="@+id/btnPunctuation"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:background="@drawable/kb_button"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_punctuation_24dp"
                android:contentDescription="Punctuation"/>

            <ImageButton
                android:id="@+id/btnNumbers"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:background="@drawable/kb_button"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_numbers_24dp"
                android:contentDescription="Numbers"/>

            <ImageButton
                android:id="@+id/btnDel"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:background="@drawable/kb_button"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_keyboard_del_48dp"
                android:contentDescription="@string/delete_button"/>

            <ImageButton
                android:id="@+id/btnEnter"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:background="@drawable/kb_button"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_keyboard_return_48dp"
                android:contentDescription="@string/return_button"/>
        </LinearLayout>

    </LinearLayout>
</LinearLayout>
