<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:clipToPadding="false"
    android:padding="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/keyboard_bg"
        android:padding="10dp">

        <ProgressBar
            android:id="@+id/processing_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:indeterminate="false"
            android:progressTint="@color/accent"
            android:progressBackgroundTint="@color/surface_container_high"
            android:indeterminateTint="@color/accent"
            style="?android:attr/progressBarStyleHorizontal"/>

        <TextView
            android:id="@+id/tv_status"
            android:visibility="gone"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="10dp"
            android:layout_marginTop="4dp"
            android:textSize="14sp"
            android:textColor="@color/text_secondary" />

        <!-- Mic center -->
        <ImageButton
            android:id="@+id/btnRecord"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="6dp"
            android:background="@drawable/kb_mic_button"
            android:padding="16dp"
            android:src="@drawable/ic_mic_48dp"
            android:contentDescription="@string/record_button"/>

        <!-- Unified bottom row: auto | backspace | . | , | ? | ! | space | enter | keyboard | (stop) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="10dp">

            <ImageButton
                android:id="@+id/btnModeAuto"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/kb_button"
                android:padding="8dp"
                android:src="@drawable/ic_auto_off_36dp"
                android:contentDescription="@string/auto_button"/>

            <ImageButton
                android:id="@+id/btnStop"
                android:visibility="gone"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/kb_button"
                android:padding="8dp"
                android:src="@drawable/ic_stop_recording_36dp"
                android:contentDescription="@string/stop_button"/>

            <ImageButton
                android:id="@+id/btnKeyboard"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/kb_button"
                android:padding="8dp"
                android:src="@drawable/ic_keyboard_36dp"
                android:contentDescription="@string/exit_button"/>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>

            <ImageButton
                android:id="@+id/btnDel"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/kb_button"
                android:padding="8dp"
                android:src="@drawable/ic_keyboard_del_48dp"
                android:contentDescription="@string/delete_button"/>

            <TextView
                android:id="@+id/btnPeriod"
                android:layout_width="36dp"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/kb_button"
                android:text="."
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center"
                android:textColor="@color/text_primary"/>

            <TextView
                android:id="@+id/btnComma"
                android:layout_width="36dp"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/kb_button"
                android:text=","
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center"
                android:textColor="@color/text_primary"/>

            <TextView
                android:id="@+id/btnQuestion"
                android:layout_width="36dp"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/kb_button"
                android:text="?"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center"
                android:textColor="@color/text_primary"/>

            <TextView
                android:id="@+id/btnExclaim"
                android:layout_width="36dp"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/kb_button"
                android:text="!"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center"
                android:textColor="@color/text_primary"/>

            <TextView
                android:id="@+id/btnSpace"
                android:layout_width="72dp"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/kb_button"
                android:text="␣"
                android:textSize="14sp"
                android:gravity="center"
                android:textColor="@color/text_primary"/>

            <ImageButton
                android:id="@+id/btnEnter"
                android:layout_width="44dp"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/kb_button"
                android:padding="8dp"
                android:src="@drawable/ic_keyboard_return_48dp"
                android:contentDescription="@string/return_button"/>
        </LinearLayout>

    </LinearLayout>
</LinearLayout>
