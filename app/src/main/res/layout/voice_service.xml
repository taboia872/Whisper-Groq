<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:clipToPadding="false"
    android:padding="10dp">

    <!-- Glass container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/keyboard_glass_bg"
        android:padding="12dp">

        <ProgressBar
            android:id="@+id/processing_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:indeterminate="false"
            android:progressTint="@color/glass_accent"
            android:progressBackgroundTint="@color/glass_surface"
            android:indeterminateTint="@color/glass_accent"
            style="?android:attr/progressBarStyleHorizontal"/>

        <!-- Top row: mode toggle + keyboard -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp">

            <ImageButton
                android:id="@+id/btnModeAuto"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_alignParentStart="true"
                android:background="@drawable/glass_button"
                android:padding="6dp"
                android:src="@drawable/ic_auto_off_36dp"
                android:contentDescription="@string/auto_button"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnKeyboard"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginHorizontal="4dp"
                    android:background="@drawable/glass_button"
                    android:padding="6dp"
                    android:src="@drawable/ic_keyboard_36dp"
                    android:contentDescription="@string/exit_button"/>

                <ImageButton
                    android:id="@+id/btnStop"
                    android:visibility="gone"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginHorizontal="4dp"
                    android:background="@drawable/glass_button"
                    android:padding="6dp"
                    android:src="@drawable/ic_stop_recording_36dp"
                    android:contentDescription="@string/stop_button"/>
            </LinearLayout>

        </RelativeLayout>

        <TextView
            android:id="@+id/tv_status"
            android:visibility="gone"
            android:gravity="center_horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="10dp"
            android:textSize="16sp"
            android:textColor="@color/glass_text" />

        <!-- Main row: mic center, del/enter right -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/layout_buttons"
            android:layout_marginTop="6dp">

            <ImageButton
                android:id="@+id/btnRecord"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_centerHorizontal="true"
                android:background="@drawable/glass_mic_button"
                android:padding="14dp"
                android:src="@drawable/ic_mic_48dp"
                android:contentDescription="@string/record_button"/>

            <ImageButton
                android:id="@+id/btnDel"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_toStartOf="@id/btnEnter"
                android:layout_marginHorizontal="3dp"
                android:layout_alignBottom="@id/btnRecord"
                android:background="@drawable/glass_button"
                android:padding="8dp"
                android:src="@drawable/ic_keyboard_del_48dp"
                android:contentDescription="@string/delete_button"/>

            <ImageButton
                android:id="@+id/btnEnter"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_alignParentEnd="true"
                android:layout_alignBottom="@id/btnRecord"
                android:layout_marginHorizontal="3dp"
                android:background="@drawable/glass_button"
                android:padding="8dp"
                android:src="@drawable/ic_keyboard_return_48dp"
                android:contentDescription="@string/return_button"/>
        </RelativeLayout>

        <!-- Punctuation row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/btnPeriod"
                android:layout_width="56dp"
                android:layout_height="40dp"
                android:layout_marginHorizontal="4dp"
                android:background="@drawable/glass_button"
                android:text="."
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center"
                android:textColor="@color/glass_text"/>

            <TextView
                android:id="@+id/btnComma"
                android:layout_width="56dp"
                android:layout_height="40dp"
                android:layout_marginHorizontal="4dp"
                android:background="@drawable/glass_button"
                android:text=","
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center"
                android:textColor="@color/glass_text"/>

            <TextView
                android:id="@+id/btnQuestion"
                android:layout_width="56dp"
                android:layout_height="40dp"
                android:layout_marginHorizontal="4dp"
                android:background="@drawable/glass_button"
                android:text="?"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center"
                android:textColor="@color/glass_text"/>

            <TextView
                android:id="@+id/btnExclaim"
                android:layout_width="56dp"
                android:layout_height="40dp"
                android:layout_marginHorizontal="4dp"
                android:background="@drawable/glass_button"
                android:text="!"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center"
                android:textColor="@color/glass_text"/>
        </LinearLayout>

    </LinearLayout>
</LinearLayout>
