<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:clipToPadding="false"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/keyboard_bg"
        android:padding="10dp">

        <ProgressBar
            android:id="@+id/processing_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:indeterminate="false"
            android:progressTint="@color/ime_accent"
            android:progressBackgroundTint="@color/surface_container_high"
            android:indeterminateTint="@color/ime_accent"
            style="?android:attr/progressBarStyleHorizontal"/>

        <TextView
            android:id="@+id/tv_status"
            android:visibility="gone"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="10dp"
            android:layout_marginTop="4dp"
            android:textSize="14sp"
            android:textColor="@color/text_secondary" />

        <!-- Mic center -->
        <ImageButton
            android:id="@+id/btnRecord"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginVertical="8dp"
            android:background="@drawable/kb_mic_button"
            android:padding="20dp"
            android:src="@drawable/ic_mic_48dp"
            android:contentDescription="@string/record_button"/>

        <!-- Keyboard-style uniform button row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <ImageButton
                android:id="@+id/btnModeAuto"
                style="@style/KbKey"
                android:src="@drawable/ic_auto_off_36dp"
                android:contentDescription="@string/auto_button"/>

            <ImageButton
                android:id="@+id/btnKeyboard"
                style="@style/KbKey"
                android:src="@drawable/ic_keyboard_36dp"
                android:contentDescription="@string/exit_button"/>

            <ImageButton
                android:id="@+id/btnStop"
                style="@style/KbKey"
                android:visibility="gone"
                android:src="@drawable/ic_stop_recording_36dp"
                android:contentDescription="@string/stop_button"/>

            <ImageButton
                android:id="@+id/btnDel"
                style="@style/KbKey"
                android:src="@drawable/ic_keyboard_del_48dp"
                android:contentDescription="@string/delete_button"/>

            <TextView
                android:id="@+id/btnPeriod"
                style="@style/KbKey.Text"
                android:text="."/>

            <TextView
                android:id="@+id/btnComma"
                style="@style/KbKey.Text"
                android:text=","/>

            <TextView
                android:id="@+id/btnQuestion"
                style="@style/KbKey.Text"
                android:text="?"/>

            <TextView
                android:id="@+id/btnExclaim"
                style="@style/KbKey.Text"
                android:text="!"/>

            <TextView
                android:id="@+id/btnSpace"
                style="@style/KbKey.Text.Wide"
                android:text="␣"/>

            <ImageButton
                android:id="@+id/btnEnter"
                style="@style/KbKey"
                android:src="@drawable/ic_keyboard_return_48dp"
                android:contentDescription="@string/return_button"/>
        </LinearLayout>

    </LinearLayout>
</LinearLayout>
