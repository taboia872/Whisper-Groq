<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fitsSystemWindows="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/recognizer_background"
        android:layout_gravity="bottom"
        android:padding="12dp">

        <ProgressBar
            android:id="@+id/processing_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:indeterminate="false"
            android:progressTint="@color/colorAccent"
            android:progressBackgroundTint="@color/lightGrey"
            android:indeterminateTint="@color/colorAccent"
            style="?android:attr/progressBarStyleHorizontal"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center">

            <!-- Cancel -->
            <ImageButton
                android:id="@+id/btnCancel"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="4dp"
                android:background="@drawable/kb_button"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_cancel_36dp"
                android:contentDescription="@string/exit_button"/>

            <!-- Stop (auto mode) -->
            <ImageButton
                android:id="@+id/btnStop"
                android:visibility="gone"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="4dp"
                android:background="@drawable/kb_button"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_stop_recording_36dp"
                android:contentDescription="@string/stop_button"/>

            <!-- Auto mode toggle -->
            <ImageButton
                android:id="@+id/btnModeAuto"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="4dp"
                android:background="@drawable/kb_button"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_auto_off_36dp"
                android:contentDescription="@string/auto_button"/>

        </LinearLayout>

        <!-- Record -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnRecord"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/kb_mic_button"
                android:padding="18dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_mic_48dp"
                android:contentDescription="@string/record_button"/>

        </LinearLayout>

    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>