<?xml version="1.0" encoding="utf-8"?>
<!-- Accent icon tint: colorPrimary normally (active state), colorOnPrimary
     when its host button is pressed (background flips to colorPrimary). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true" android:color="?attr/colorOnPrimary"/>
    <item android:color="?attr/colorPrimary"/>
</selector>
