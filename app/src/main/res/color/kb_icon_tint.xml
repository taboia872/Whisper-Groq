<?xml version="1.0" encoding="utf-8"?>
<!-- Icon tint that flips with the kb_button pressed state: neutral buttons
     show colorOnSurface normally, colorOnPrimary when pressed (the button
     background turns colorPrimary). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true" android:color="?attr/colorOnPrimary"/>
    <item android:color="?attr/colorOnSurface"/>
</selector>
